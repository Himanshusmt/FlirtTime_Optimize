<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppBaseURL</key>
	<string>https://flirttimeapi.walit.in</string>
	<key>ChatBaseURL</key>
	<string>$(CHAT_BASE_URL)</string>
	<key>ChatMediaBaseURL</key>
	<string>$(CHAT_MEDIA_BASE_URL)</string>
	<key>ChatSocketPath</key>
	<string>$(CHAT_SOCKET_PATH)</string>
	<key>ChatSocketURL</key>
	<string>$(CHAT_SOCKET_URL)</string>
	<key>GoogleMapsAPIKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>Fredoka-Medium.ttf</string>
		<string>Fredoka-Regular.ttf</string>
		<string>Fredoka-SemiBold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>NSVoIPUsageDescription</key>
	<string>Flirttime uses VoIP so you can receive audio and video calls when the app is in the background or closed.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
		<string>remote-notification</string>
	</array>
	<key>UIDesignRequiresCompatibility</key>
	<true/>
</dict>
</plist>
